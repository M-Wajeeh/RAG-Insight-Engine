# =============================================================================
# RAG-Insight-Engine — ignore generated, local, and secret artifacts
# =============================================================================

# --- Secrets & environment ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Python bytecode & packaging ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
ENV/
env/
.envrc

# --- uv (https://docs.astral.sh/uv/) -----------------------------------------
# Keep uv.lock in git if you use `uv lock`; remove the ignore line below if you add one.
# uv.lock
.uv/

# --- Test / typing / lint caches -----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py.cover
.hypothesis/
nosetests.xml
junit.xml

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Type checkers / IDEs ----------------------------------------------------
.idea/
*.swp
*.swo
*~

# VS Code — uncomment if you do not want committed workspace settings:
# .vscode/
# *.code-workspace

# --- OS ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs & temp -------------------------------------------------------------
*.log
logs/
*.tmp
*.temp

# --- Vector DB & local persistence (Chroma / similar) ------------------------
chroma/
chroma_db/
.chroma/
vectorstore/**/*.sqlite3
vectorstore/**/*.sqlite3-journal
vectorstore/**/*.parquet

# Uncomment if you persist collections under vectorstore explicitly:
vectorstore/storage/
vectorstore/persist/

# --- ML caches (often huge; uncomment if you keep them inside the repo) ------
.cache/
hub/
models/
checkpoints/

# --- Raw corpus (optional) ----------------------------------------------------
# Uncomment to stop tracking uploads; keep a .gitkeep in data/raw if needed.
# data/raw/*
# !data/raw/.gitkeep
# data/processed/*

# =============================================================================